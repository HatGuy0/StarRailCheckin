<?xml version="1.0" encoding="utf-8"?>
<!-- 提醒弹窗 · 深色液态玻璃卡：外层受光描边 + 半透磨砂主体 + 顶部内高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 外层高光描边层：左上偏亮白、右下偏紫，模拟玻璃边缘受光 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#8CFFFFFF"
                android:centerColor="#4D8B7CF6"
                android:endColor="#335A4BD1" />
        </shape>
    </item>

    <!-- 玻璃主体层：竖向半透深紫灰渐变，提高通透度让背后内容隐约透出 -->
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="22.5dp" />
            <gradient
                android:angle="135"
                android:startColor="#662A2448"
                android:centerColor="#4D1C1836"
                android:endColor="#400F0C22" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>

    <!-- 顶部内高光层：上亮下透，模拟玻璃顶面反光 -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>
