<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗弹窗（后台/锁屏回退，无Material主题，只用系统控件）；宽扁卡片 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" >

    <FrameLayout android:id="@+id/cardRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginHorizontal="28dp" android:background="@drawable/bg_remind_glass_card" >

        <ImageView android:id="@+id/ivCardBg" android:layout_width="0dp" android:layout_height="0dp" android:contentDescription="@string/home_custom_bg" android:scaleType="centerCrop" android:visibility="gone" />

        <View android:id="@+id/ivCardMask" android:layout_width="0dp" android:layout_height="0dp" android:background="#99141428" android:visibility="gone" />

        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="top|end" android:layout_marginTop="10dp" android:layout_marginEnd="12dp" android:alpha="0.35" android:contentDescription="@null" android:rotation="16" android:src="@drawable/ic_sakura" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" >

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" >

                <ImageView android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@string/remind_title" android:src="@mipmap/ic_launcher" />

                <TextView android:id="@+id/tvRemindTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/remind_title" android:textColor="@color/anime_gold" android:textSize="19sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/tvRemindMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:lineSpacingExtra="4dp" android:text="@string/remind_message" android:textColor="#E9E7F7" android:textSize="13sp" />

            <Button android:id="@+id/btnLaunchGame" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="16dp" android:background="@drawable/bg_hsr_btn_gold" android:text="@string/remind_launch" android:textColor="#1A1A2E" android:textSize="14sp" android:textStyle="bold" android:stateListAnimator="@null" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" >

                <Button android:id="@+id/btnSnooze" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_remind_glass_outline" android:minWidth="0dp" android:text="@string/remind_snooze" android:textColor="#E8E0C8" android:textSize="12sp" android:stateListAnimator="@null" />

                <Button android:id="@+id/btnClose" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_remind_glass_outline" android:minWidth="0dp" android:text="@string/remind_close" android:textColor="#B8B8C8" android:textSize="12sp" android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
