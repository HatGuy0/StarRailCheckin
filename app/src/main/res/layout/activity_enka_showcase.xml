<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 星空碎石背景（竖屏裁切适配） -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/enka_bg" />

    <!-- 深色压暗遮罩：保留星空氛围，卡片外文字改浅色 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#590A0D18" />

    <ScrollView
        android:id="@+id/enkaShowcaseScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp">

        <!-- 玩家信息 -->
        <TextView
            android:id="@+id/tvPlayerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#EDEBFA"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- 全队总览入口 -->
        <LinearLayout
            android:id="@+id/btnOpenOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="10dp"
            android:background="#22FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 全队练度总览 / 遗器仓库"
                android:textColor="#EDEBFA"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 角色头像横向列表 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/charAvatarRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="4dp" />
        </HorizontalScrollView>

        <!-- ============ 角色主卡（参考图：左立绘 + 右属性面板） ============ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/charDetailCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <!-- 上部：左立绘 + 右属性 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 左侧立绘区 -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="340dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/ivCharPortrait"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <!-- 左下角 UID -->
                        <TextView
                            android:id="@+id/tvCharUID"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginLeft="12dp"
                            android:layout_marginBottom="12dp"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:shadowColor="#000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4" />
                    </FrameLayout>

                    <!-- 右侧属性面板 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- 角色名 + 等级 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvCharLevelBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#e74c3c"
                                android:paddingLeft="8dp"
                                android:paddingRight="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="LV.80"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvCharName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="#EDEBFA"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>

                        <!-- 元素 + 命途 -->
                        <LinearLayout
                            android:id="@+id/elemPathRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:id="@+id/tvElement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#f4d03f"
                                android:textSize="12sp"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:id="@+id/tvPath"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#aed6f1"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- 属性行容器（动态生成） -->
                        <LinearLayout
                            android:id="@+id/panelStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 底部技能栏（5个技能图标横排） -->
                <LinearLayout
                    android:id="@+id/skillsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="12dp"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============ 光锥 + 遗器评分横栏 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <!-- 光锥卡 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivLightCone"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="10dp"
                        android:background="#F0EDF7" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLightConeName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#f5b041"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLightCone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#A39DBA"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 遗器评分卡 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvRelicScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#EDEBFA"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="遗器评分"
                            android:textColor="#A39DBA"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvRelicGrade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            text="--"
                            android:textColor="#e74c3c"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="遗器评级"
                            android:textColor="#A39DBA"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ============ 遗器 2x3 网格 ============ -->
        <LinearLayout
            android:id="@+id/relicContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <!-- 隐藏兼容字段 -->
        <TextView
            android:id="@+id/tvSkillTree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvPropSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- 底部提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="数据来自 Mihomo（鳄梨）第三方服务 · 评分仅供参考"
            android:textColor="#A39DBA"
            android:textSize="11sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
