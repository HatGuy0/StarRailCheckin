<?xml version="1.0" encoding="utf-8"?>
<!-- 二次元星海弹窗卡：紫色光边 + 深空磨砂 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="315"
                android:startColor="@color/anime_dialog_stroke"
                android:centerColor="#8AB9AFFF"
                android:endColor="#4D5EE7FF" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient android:angle="135"
                android:startColor="@color/anime_dialog_top"
                android:endColor="@color/anime_dialog_bottom" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
